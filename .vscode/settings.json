{
    "terminal.integrated.profiles.osx": {
        "devboxCompatibleShell": {
            "path": "/bin/zsh",
            "args": []
        }
    },
    "terminal.integrated.defaultProfile.osx": "devboxCompatibleShell",
    // override so we don't use GOPATH and accidentally clutter up home dir
    "go.toolsGopath": "${workspaceFolder}/.go",
    "go.toolsManagement.autoUpdate": true,
    // non-default: avoids invalid "Prompt" enum error from gopls
    "go.diagnostic.vulncheck": "Imports",
    // point at the devbox-managed binaries so the extension works without sourcing the devbox shell
    // NOTE: the vscode-just extension does not expand ${workspaceFolder}, but it does spawn these
    // relative to the workspace root, so a repo-relative path works and stays portable
    "vscode-just.justPath": ".devbox/nix/profile/default/bin/just",
    "vscode-just.lspPath": ".devbox/nix/profile/default/bin/just-lsp",
}
